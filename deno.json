{
  "nodeModulesDir": "auto",
  "tasks": {
    "dev": "deno run -A --node-modules-dir npm:vite dev --host",
    "build": "deno run -A --node-modules-dir npm:vite build",
    "preview": "deno run -A --node-modules-dir npm:vite preview",
    "check": "deno run -A --node-modules-dir npm:svelte-check --tsconfig ./tsconfig.json",
    "test": "deno test -A --sloppy-imports src/",
    "lint": "deno run -A --node-modules-dir npm:prettier --check . && deno run -A --node-modules-dir npm:eslint .",
    "format": "deno run -A --node-modules-dir npm:prettier --write ."
  },
  "imports": {
    "$lib/": "./src/lib/",
    "$lib": "./src/lib/index.ts"
  },
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext", "deno.ns"]
  }
}
