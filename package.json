{
	"name": "blueshelf",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "pnpm@11.22.0",

	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"compile": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide",
		"sync": "pnpm run compile && svelte-kit sync",
		"prepare": "pnpm run sync || echo ''",
		"check": "pnpm run sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "pnpm run sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "tsx --test \"src/lib/**/*.test.ts\"",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write ."
	},
	"dependencies": {
		"@atproto/api": "^0.20.41",
		"@atproto/oauth-client-browser": "^0.5.3",
		"@fontsource-variable/noto-sans-jp": "^5.3.0",
		"@lucide/svelte": "^1.31.0",
		"@vite-pwa/sveltekit": "^1.1.0",
		"bits-ui": "^2.18.1",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"dexie": "^4.4.5",
		"dompurify": "^3.4.13",
		"mode-watcher": "^1.1.0",
		"svelte-sonner": "^1.2.1",
		"tailwind-merge": "^3.6.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@inlang/paraglide-js": "^2.18.2",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^26",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"tsx": "^4.19.3",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16"
	}
}
